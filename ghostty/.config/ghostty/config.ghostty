fullscreen = true
clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false
theme = Matte Black
background = #121212
background-opacity = 0.90
background-blur-radius = 20
gtk-titlebar-hide-when-maximized = true
gtk-tabs-location = hidden
font-family = JetBrainsMono Nerd Font
font-size = 14
scrollback-limit = 10_000
window-theme = ghostty
window-padding-y = 0
foreground = #bebebe
selection-background = #333333
selection-foreground = #eaeaea
selection-invert-fg-bg = true
cursor-color = #eaeaea
cursor-text = #121212
cursor-invert-fg-bg = true
palette = 0=#333333
palette = 1=#d35f5f
palette = 2=#ffc107
palette = 3=#b91c1c
palette = 4=#e68e0d
palette = 5=#d35f5f
palette = 6=#bebebe
palette = 7=#bebebe
palette = 8=#8a8a8d
palette = 9=#891c1c
palette = 10=#ffc107
palette = 11=#b90a0a
palette = 12=#f59e0b
palette = 13=#b91c1c
palette = 14=#eaeaea
palette = 15=#ffffff
