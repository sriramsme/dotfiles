#!/usr/bin/env bash

AGENTS_FILE="$HOME/.config/agents/AGENTS.md"

if [ ! -f "$AGENTS_FILE" ]; then
    echo "Error: $AGENTS_FILE not found. Stow the agents package first."
    exit 1
fi

# Resolve this script through its Stow symlink to find the dotfiles repo.
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
DOTFILES_DIR="$(dirname "$(dirname "$(dirname "$SCRIPT_PATH")")")"
SKILLS_DIR="$DOTFILES_DIR/.agents/skills"

if [ ! -d "$SKILLS_DIR" ]; then
    echo "Error: $SKILLS_DIR not found."
    exit 1
fi

if [ -e "$HOME/.agents/skills" ] || [ -L "$HOME/.agents/skills" ]; then
    if [ "$(readlink -f "$HOME/.agents/skills")" != "$SKILLS_DIR" ]; then
        echo "Error: $HOME/.agents/skills already exists. Move or merge it before running agents-setup."
        exit 1
    fi
fi

mkdir -p "$HOME/.agents" || exit 1
ln -sfnT "$SKILLS_DIR" "$HOME/.agents/skills" || exit 1
echo "Skills: $HOME/.agents/skills -> $SKILLS_DIR"

echo "Setting up agent symlinks..."

# claude
mkdir -p "$HOME/.claude"
ln -sf "$AGENTS_FILE" "$HOME/.claude/CLAUDE.md"
echo "✓ Claude → $AGENTS_FILE"

# codex
mkdir -p "$HOME/.codex"
ln -sf "$AGENTS_FILE" "$HOME/.codex/AGENTS.md"
echo "✓ Codex → $AGENTS_FILE"

# opencode
mkdir -p "$HOME/.config/opencode"
ln -sf "$AGENTS_FILE" "$HOME/.config/opencode/AGENTS.md"
echo "✓ Opencode → $AGENTS_FILE"

echo "Done!"
